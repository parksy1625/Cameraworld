# Cameraworld — local development environment

# --- Postgres ---
POSTGRES_USER=cameraworld
POSTGRES_PASSWORD=cameraworld
POSTGRES_DB=cameraworld
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis (job queue) ---
REDIS_URL=redis://redis:6379/0

# --- MinIO (S3-compatible object storage) ---
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=cameraworld
S3_SECRET_KEY=cameraworld-secret
S3_BUCKET_CAPTURES=cameraworld-captures
S3_BUCKET_ARTIFACTS=cameraworld-artifacts
S3_PUBLIC_ENDPOINT=http://localhost:9000

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Pipeline ---
PIPELINE_WORKDIR=/tmp/cameraworld-workdir
PIPELINE_FRAME_FPS=3
PIPELINE_BLUR_THRESHOLD=60
PIPELINE_MAX_IMAGE_DIM=1600
PIPELINE_GS_ITERATIONS=30000

# --- COLMAP binary (path inside worker container) ---
COLMAP_BIN=colmap
FFMPEG_BIN=ffmpeg

# --- Gaussian Splatting ---
GS_REPO_PATH=/opt/gaussian-splatting
